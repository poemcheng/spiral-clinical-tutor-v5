FROM python:3.13-slim
WORKDIR /app
COPY requirements-graphics.txt ./
RUN pip install --no-cache-dir -r requirements-graphics.txt
COPY backend ./backend
COPY frontend/graphics ./frontend/graphics
RUN useradd --uid 10001 --create-home tutor && mkdir -p /app/runtime/graphics && chown -R tutor:tutor /app
USER tutor
ENV GRAPHICS_HOME=/app/runtime/graphics DEPLOYMENT_MODE=public
EXPOSE 8715
HEALTHCHECK --interval=30s --start-period=10s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8715/api/health',timeout=5)"
CMD ["python", "-m", "uvicorn", "backend.graphics_server:app", "--host", "0.0.0.0", "--port", "8715"]
