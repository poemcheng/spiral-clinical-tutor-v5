PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8705
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=120
# Optional: set the local original teaching-video directory on another computer.
# VIDEO_LIBRARY_DIR=D:/training/videos
# COOKIE_SECURE=1  # enable when deployed over HTTPS
# LIVEKIT_URL=wss://your-livekit-server
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Local LiveKit is started by run.py. Random credentials stay in ignored runtime/.
# DISABLE_LOCAL_VOICE=1  # optional: disable local voice service autostart
# Ten supplied character cards and original stylized VRM models are in data/characters/.
# H5P practice runs locally; formal clinical decisions are graded by the backend.

# Public container only: use a clean volume, never the local learner DB.
# DEPLOYMENT_MODE=public
# BOOTSTRAP_ADMIN_PASSWORD=
# OLLAMA_API_KEY=

# Local LAN: python tools/run_lan.py --address YOUR_PRIVATE_IPV4
# HTTPS uses port 8765. Install runtime/lan-tls/clinical-tutor-ca.cer on clients.
# Main SQLite remains the default; opt in after verifying a PostgreSQL migration.
# DATABASE_URL=postgresql://tutor:password@localhost:5432/clinical_tutor
# POSTGRES_PASSWORD=
# TTS_ENGINE=windows   # Windows LAN default; Linux uses piper
# PIPER_MALE_MODEL=/models/zh_male.onnx
# PIPER_FEMALE_MODEL=/models/zh_female.onnx
# Each Piper model needs .identity.json with gender, zh language and model SHA256.
# XAPI_ACTIVITY_BASE=https://your-training-domain/xapi/
